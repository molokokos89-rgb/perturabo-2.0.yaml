{
  "mode": "rule",
  "log-level": "info",
  "ipv6": false,
  "dns": {
    "enable": true,
    "listen": "127.0.0.1:53",
    "ipv6": false,
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.0/15",
    "fake-ip-filter": [
      "*.lan",
      "*.localdomain",
      "*.example",
      "*.invalid",
      "*.localhost",
      "*.test",
      "*.local",
      "*.home.arpa",
      "time.*.com",
      "time.*.gov",
      "time.*.edu.cn",
      "time.*.apple.com",
      "time.nist.gov",
      "time.windows.com",
      "time.nts.net",
      "nTP.msn.com",
      "pool.ntp.org"
    ],
    "default-nameserver": [
      "8.8.8.8",
      "8.8.4.4",
      "77.88.8.8",
      "9.9.9.9"
    ],
    "nameserver": [
      "https://dns.google/dns-query",
      "https://dns.quad9.net/dns-query",
      "https://dns.adguard-dns.com/dns-query",
      "8.8.8.8",
      "8.8.4.4",
      "9.9.9.9"
    ],
    "fallback": [
      "https://dns.google/dns-query",
      "tls://8.8.8.8:853",
      "tls://9.9.9.9:853"
    ],
    "fallback-filter": {
      "geoip": true,
      "geoip-code": "RU",
      "ipcidr": [
        "240.0.0.0/4"
      ]
    }
  },
  "proxy-providers": {
    "ss-main": {
      "type": "http",
      "url": "https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/BLACK_SS%2BAll_RUS.txt",
      "interval": 3600,
      "path": "./ss_main.yaml",
      "health-check": {
        "enable": true,
        "url": "http://www.gstatic.com/generate_204",
        "interval": 300
      }
    },
    "vless-commit": {
      "type": "http",
      "url": "https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/8a0ea60f714033c3ff85ab67f08d944fe2fe0776/BLACK_VLESS_RUS.txt",
      "interval": 3600,
      "path": "./vless_commit.yaml",
      "health-check": {
        "enable": true,
        "url": "http://www.gstatic.com/generate_204",
        "interval": 300
      }
    },
    "vless-main": {
      "type": "http",
      "url": "https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/BLACK_VLESS_RUS.txt",
      "interval": 3600,
      "path": "./vless_main.yaml",
      "health-check": {
        "enable": true,
        "url": "http://www.gstatic.com/generate_204",
        "interval": 300
      }
    }
  },
  "proxy-groups": [
    {
      "name": "PROXY",
      "type": "select",
      "use": [
        "ss-main",
        "vless-commit",
        "vless-main"
      ]
    }
  ],
  "rule-providers": {
    "reject_rules": {
      "type": "http",
      "behavior": "domain",
      "url": "https://raw.githubusercontent.com/molokokos89-rgb/perturabo-2.0.yaml/main/reject_rules.json",
      "path": "./rules/reject_rules.json",
      "interval": 86400
    },
    "my_rules_proxy": {
      "type": "http",
      "behavior": "domain",
      "url": "https://raw.githubusercontent.com/molokokos89-rgb/perturabo-2.0.yaml/main/my_rules_proxy.json",
      "path": "./rules/my_rules_proxy.json",
      "interval": 86400
    },
    "my_rules_rus": {
      "type": "http",
      "behavior": "domain",
      "url": "https://raw.githubusercontent.com/molokokos89-rgb/perturabo-2.0.yaml/main/My_rules_RUS.json",
      "path": "./rules/my_rules_rus.json",
      "interval": 86400
    }
  },
  "rules": [
    "RULE-SET,reject_rules,REJECT",
    "RULE-SET,my_rules_proxy,PROXY",
    "RULE-SET,my_rules_rus,DIRECT",
    "DOMAIN,bag.itunes.apple.com,DIRECT",
    "DOMAIN-SUFFIX,apple.com,DIRECT",
    "DOMAIN-SUFFIX,cdn-apple.com,DIRECT",
    "DOMAIN-SUFFIX,icloud.com,DIRECT",
    "DOMAIN-SUFFIX,ru,DIRECT",
    "DOMAIN-SUFFIX,su,DIRECT",
    "DOMAIN-SUFFIX,rf,DIRECT",
    "DOMAIN-SUFFIX,yandex.ru,DIRECT",
    "DOMAIN-SUFFIX,vk.com,DIRECT",
    "GEOIP,RU,DIRECT,no-resolve",
    "GEOIP,LAN,DIRECT,no-resolve",
    "MATCH,PROXY"
  ]
}