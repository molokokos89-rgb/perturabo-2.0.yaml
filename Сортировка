port: 0
socks-port: 0
redir-port: 0
tproxy-port: 0
mixed-port: 7890
allow-lan: false
bind-address: '*'
mode: rule
log-level: error
ipv6: false
global-client-fingerprint: chrome
keep-alive-idle: 30
keep-alive-interval: 30
dns:
    enable: true
    prefer-h3: true
    ipv6: false
    ipv6-timeout: 300
    use-hosts: true
    use-system-hosts: true
    respect-rules: true
    nameserver:
        - 9.9.9.9
        - 8.8.8.8
        - 8.8.4.4
        - 1.0.0.1
        - 1.1.1.1
        - tls://9.9.9.9
        - tls://8.8.8.8
        - tls://8.8.4.4
        - tls://1.0.0.1
        - tls://1.1.1.1
        - https://cloudflare-dns.com
        - quic://://adguard.com
        - system
    fallback: []
    fallback-filter:
        geoip: true
        geoip-code: CN
        ipcidr: []
        domain: []
        geosite: []
    listen: ""
    enhanced-mode: fake-ip
    fake-ip-range: 172.19.0.1/16
    fake-ip-range6: ""
    fake-ip-filter:
        - '*.lan'
        - '*.local'
        - time.*.com
        - time.*.gov
        - time.*.apple.com
        - ://apple.com
        - time1.*.com
        - time2.*.com
        - time3.*.com
        - time4.*.com
        - time5.*.com
        - time6.*.com
        - time7.*.com
        - ntp.*.com
        - ntp1.*.com
        - ntp2.*.com
        - ntp3.*.com
        - ntp4.*.com
        - ntp5.*.com
        - ntp6.*.com
        - ntp7.*.com
        - '*.pool.ntp.org'
        - +.services.googleapis.cn
        - +.push.apple.com
        - +.stun.*.*
        - +.stun.*.*.*
        - +.stun.*.*.*.*
        - +.stun.*.*.*.*.*
        - ://google.com
        - xbox.*.*.microsoft.com
        - '*.*.xboxlive.com'
        - '*.msftncsi.com'
        - '*.msftconnecttest.com'
        - WORKGROUP
    fake-ip-filter-mode: blacklist
    fake-ip-ttl: 1
    default-nameserver:
        - 9.9.9.9
        - 8.8.8.8
        - 8.8.4.4
        - 1.0.0.1
        - 1.1.1.1
        - system
    cache-algorithm: arc
    cache-max-size: 0
    nameserver-policy: null
    proxy-server-nameserver:
        - 9.9.9.9
        - 8.8.8.8
        - 8.8.4.4
        - 1.0.0.1
        - 1.1.1.1
        - tls://9.9.9.9
        - tls://8.8.4.4
        - tls://1.1.1.1
    proxy-server-nameserver-policy: null
    direct-nameserver:
        - system
    direct-nameserver-follow-policy: false
ntp:
    enable: false
    server: ://apple.com
    port: 123
    interval: 30
    dialer-proxy: ""
    write-to-system: false
tun:
    enable: true
    stack: mixed
    auto-route: true
    auto-detect-interface: false
    mtu: 4064
    gso: false
    gso-max-size: 0
    inet4-address:
        - 172.19.0.1/30
    inet6-address: []
    iproute2-table-index: 0
    iproute2-rule-index: 0
    auto-redirect: false
    auto-redirect-input-mark: 0
    auto-redirect-output-mark: 0
    auto-redirect-iproute2-fallback-rule-index: 0
    loopback-address: []
    strict-route: false
    route-address: []
    route-address-set: []
    route-exclude-address:
        - 0.0.0.0/31
        - ::/127
    route-exclude-address-set: []
    include-interface: []
    exclude-interface: []
    include-uid: []
    include-uid-range: []
    exclude-uid: []
    exclude-uid-range: []
    exclude-src-port: []
proxy-providers:
  vless-sub-1:
    type: http
    url: https://githubusercontent.com
    interval: 3600
    path: ./vless_sub_1.yaml
    health-check:
      enable: true
      url: http://gstatic.com
      interval: 600
  vless-sub-2:
    type: http
    url: https://githubusercontent.com
    interval: 7200
    path: ./vless_sub_2.yaml
    health-check:
      enable: true
      url: http://gstatic.com
      interval: 1200
proxy-groups:
  - name: VLESS-Auto
    type: url-test
    url: http://gstatic.com
    interval: 300
    tolerance: 300
    lazy: false
    use:
      - vless-sub-1
      - vless-sub-2
